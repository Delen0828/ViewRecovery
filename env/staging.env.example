# Copy to env/staging.env and fill locally. Never commit staging.env.
# Client values (public)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server/importer values (secret; never use a VITE_ prefix)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Prefer the current server secret key. Legacy service-role keys remain supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Optional override; default certificate path is env/supabase-ca.crt
DATABASE_SSL_ROOT_CERT=
AUTH_RATE_LIMIT_SALT=
# Deployment decisions
STUDY_ID=
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Supabase Management/CLI access for staging deployment only
SUPABASE_ACCESS_TOKEN=

# Optional legacy PHP admin overrides. If omitted, use data_portal.php defaults.
# Used only by the protected legacy-access provisioner, never bundled into Vite.
DATA_PORTAL_USER=
DATA_PORTAL_PASS_HASH=
