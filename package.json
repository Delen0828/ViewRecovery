{
  "name": "jspsych-local-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "bash start-server.sh",
    "serve": "node server/index.mjs",
    "db:start": "node scripts/database.mjs",
