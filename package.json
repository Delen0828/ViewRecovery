    "@jspsych/plugin-image-button-response": "^2.1.0",
    "@jspsych/plugin-virtual-chinrest": "^3.1.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.7",
    "d3": "^7.9.0",
    "jspsych": "^8.2.1",
    "kysely": "^0.29.6",
    "pg": "^8.23.1"
